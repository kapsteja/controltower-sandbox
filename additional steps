## 3️⃣ Simple Python boto3 script ✅

📌 Run this from **AWS Organizations management account**  
📌 Use **Control Tower home region**

Save this as `move_account.py`

```python
import csv
import boto3

# CONFIG
CSV_FILE = "accounts.csv"
CONTROL_TOWER_REGION = "us-east-1"  # change if your CT home region is different

org = boto3.client("organizations")
ct  = boto3.client("controltower", region_name=CONTROL_TOWER_REGION)

def get_account_parent(account_id):
    resp = org.list_parents(ChildId=account_id)
    return resp["Parents"][0]["Id"]

def move_account(account_id, source_ou, dest_ou):
    org.move_account(
        AccountId=account_id,
        SourceParentId=source_ou,
        DestinationParentId=dest_ou
    )

def get_ou_arn(ou_id):
    resp = org.describe_organizational_unit(
        OrganizationalUnitId=ou_id
    )
    return resp["OrganizationalUnit"]["Arn"]

def reset_ct_baseline_for_ou(ou_arn):
    baselines = ct.list_enabled_baselines()["enabledBaselines"]
    for b in baselines:
        if b["targetIdentifier"] == ou_arn:
            ct.reset_enabled_baseline(
                enabledBaselineIdentifier=b["arn"]
            )
            print(f"✅ Control Tower baseline reset: {b['arn']}")

def main():
    with open(CSV_FILE) as f:
        reader = csv.DictReader(f)
        for row in reader:
            account_id = row["account_id"]
            source_ou  = row["current_ou"]
            dest_ou    = row["destination_ou"]

            print(f"\nProcessing account {account_id}")

            actual_ou = get_account_parent(account_id)
            if actual_ou != source_ou:
                print(f"❌ Account is not in {source_ou}, actual: {actual_ou}")
                continue

            move_account(account_id, source_ou, dest_ou)
            print(f"✅ Moved account to {dest_ou}")

            ou_arn = get_ou_arn(dest_ou)
            reset_ct_baseline_for_ou(ou_arn)

            print("✅ Post-move Control Tower update completed")

if __name__ == "__main__":
    main()
```

